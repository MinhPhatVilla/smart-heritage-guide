# ─────────────────────────────────────────────────────────────
# Goong Maps — bản đồ Việt Nam (https://account.goong.io)
# Sao chép file này thành `.env` hoặc `.env.local` rồi dán 2 key vào bên dưới.
# Để trống => ứng dụng tự dùng bản đồ CARTO/OpenStreetMap miễn phí.
# Lưu ý: biến EXPO_PUBLIC_* sẽ được Expo nhúng vào bundle ứng dụng.
# ─────────────────────────────────────────────────────────────

# Map Tiles key: hiển thị bản đồ nền Goong trong WebView / Web
EXPO_PUBLIC_GOONG_MAPTILES_KEY=

# REST API key: Goong Direction API (chỉ đường dự phòng khi máy chủ OSRM đi bộ lỗi)
EXPO_PUBLIC_GOONG_API_KEY=

# ─────────────────────────────────────────────────────────────
# Smart Heritage Guide Backend (FastAPI + Supabase)
# Mặc định chạy Local Uvicorn tại http://localhost:8000 (hoặc LAN IP khi test trên Expo Go thật)
# Nếu Backend chưa chạy hoặc mất mạng => ứng dụng tự fallback Offline-first không lỗi.
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
