# ─────────────────────────────────────────────────────────────
# Mapbox GL JS v3 (https://account.mapbox.com/access-tokens/)
# Sao chép file này thành `.env` hoặc `.env.local` rồi dán Public Token (bắt đầu bằng `pk.`).
# Miễn phí 50.000 lượt tải bản đồ/tháng — hỗ trợ Mapbox Standard 3D, ánh sáng Ngày/Hoàng hôn/Đêm.
# Để trống => ứng dụng tự dùng OpenStreetMap Vector 3D miễn phí (không bao giờ trắng bản đồ).
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────
# Goong Maps (tùy chọn dự phòng chỉ đường khi máy chủ OSRM đi bộ lỗi)
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_GOONG_MAPTILES_KEY=
EXPO_PUBLIC_GOONG_API_KEY=

# ─────────────────────────────────────────────────────────────
# Smart Heritage Guide Backend (FastAPI + Supabase)
# Mặc định chạy Local Uvicorn tại http://localhost:8000 (hoặc LAN IP khi test trên Expo Go thật)
# Nếu Backend chưa chạy hoặc mất mạng => ứng dụng tự fallback Offline-first không lỗi.
# ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
