{
  "name": "smart-heritage-guide-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Ứng dụng di động React Native (Expo) hướng dẫn viên du lịch di sản thông minh TP. Hồ Chí Minh: định vị GPS, thuyết minh đa ngôn ngữ, tư liệu đa phương tiện, ẩm thực gần đây, dẫn đường đi bộ và xếp hạng hành trình.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-file-system": "~58.0.14",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.22",
    "expo-speech": "~58.0.4",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^0.511.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.3.0",
    "typescript": "~5.8.3",
    "vitest": "^3.1.4"
  }
}
