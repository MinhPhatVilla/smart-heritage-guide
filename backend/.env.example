# =============================================================================
# Smart Heritage Guide Backend — Environment Configuration
# Copy this file to `.env` and fill in your credentials.
# Leave SUPABASE_* and GEMINI_API_KEY blank to run in local SQLite + fallback mode.
# =============================================================================

APP_NAME="Smart Heritage Guide API"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database URLs (dùng chung cho cả Prisma ORM và FastAPI Backend):
# - Supabase Cloud PostgreSQL (khuyên dùng — dán từ Supabase -> Connect -> ORMs -> Prisma):
#   DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"
# - Local SQLite fallback (chỉ dùng cho FastAPI local khi không chạy Prisma):
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Supabase Cloud (optional in local dev; enables GoTrue Auth + Storage bucket)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=heritage-photos

# Local JWT secret (used when SUPABASE_JWT_SECRET is not set)
JWT_SECRET_KEY=dev-smart-heritage-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google Gemini API (for RAG Chatbot + Vision AI + Embeddings; optional — fallback works without it)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Routing Proxy (FOSSGIS OSRM primary -> Goong Direction fallback -> offline Haversine)
GOONG_API_KEY=
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
ROUTE_CACHE_TTL_DAYS=7

# CORS (comma-separated origins, or * for dev)
CORS_ORIGINS=*

# Local uploads directory (fallback when Supabase Storage is not configured)
LOCAL_UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8000

# Default Admin & Demo accounts created by seed script
DEFAULT_ADMIN_EMAIL=admin@smartheritage.vn
DEFAULT_ADMIN_PASSWORD=AdminHeritage@2026
DEFAULT_DEMO_EMAIL=demo@smartheritage.vn
DEFAULT_DEMO_PASSWORD=DemoHeritage@2026
