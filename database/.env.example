# =============================================================================
# Smart Heritage Guide — Prisma Database Configuration
# Sao chép file này thành `.env` rồi dán chuỗi kết nối PostgreSQL vào DATABASE_URL.
# Sau đó chạy: npm run db:setup
# =============================================================================

# Ví dụ Supabase PostgreSQL (Transaction Pooler hoặc Direct Connection):
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Ví dụ Neon / Railway / Render PostgreSQL:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
#
# Ví dụ PostgreSQL Local (Docker):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_heritage_guide?schema=public"
